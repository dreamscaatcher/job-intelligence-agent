# LLM
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-4-5

# Apify (Search agent) - see ADR-0001 open item 1: no actor verified yet.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Profile (Match agent) - see ADR-0001 open item 2: no real profile yet.
PROFILE_PATH=agent/profile/profile.json

# LangSmith tracing - env-var-only, LangChain/LangGraph auto-detect these
# (no code changes needed, same as the Ops Intel Agent). Live-verified
# 2026-08-07. IMPORTANT: if your LangSmith workspace is on the EU region
# (eu.smith.langchain.com), you MUST set LANGCHAIN_ENDPOINT explicitly -
# the SDK defaults to the US endpoint and a EU-region key gets a silent-ish
# 403 there. Check your workspace's URL to tell which region you're on.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-intelligence-agent

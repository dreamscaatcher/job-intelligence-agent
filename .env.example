# LLM
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-4-5

# Apify (Search agent) - see ADR-0001 open item 1: no actor verified yet.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Profile (Match agent) - see ADR-0001 open item 2: no real profile yet.
PROFILE_PATH=agent/profile/profile.json

# LangSmith tracing - env-var-only, LangChain/LangGraph auto-detect these
# (no code changes needed, same as the Ops Intel Agent). Config-ready but
# NOT live-verified - no LangSmith API key was available while building
# this. Set LANGCHAIN_TRACING_V2=true and LANGCHAIN_API_KEY once you have
# one; until then tracing silently no-ops rather than erroring.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-intelligence-agent
